# ============================================================
#  CRM INTELLIHELP  ·  public_html/crm  (crm.intellihelp.tech)
#  Aísla esta carpeta del WordPress + Wordfence del raíz.
# ============================================================

# Desactivar el WAF de Wordfence (auto_prepend_file del raíz) para esta app
php_value auto_prepend_file none

# La configuración NO se fija acá.
#
# Este archivo es el mismo en las dos instalaciones —producción y pruebas—, así
# que fijar acá la ruta del config apuntaba las DOS a la de producción. Y como
# el arranque mira la variable de entorno antes que nada, la copia de pruebas
# terminaba conectada a la base real: se probaba contra los datos de los
# clientes creyendo que se probaba en el aire.
#
# No se notaba por consola, donde SetEnv no existe: sólo pasaba por el navegador,
# que es justamente por donde entra la gente.
#
# Ahora la busca el propio arranque, por el nombre de la carpeta:
#   crm/          → crm_config/config.php
#   crm-pruebas/  → crm_config/crm-pruebas.php
# y el almacenamiento sale de ese mismo archivo.

DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ---- Una sola dirección ----
    # El subdominio existe porque el hosting lo necesita para servir la carpeta,
    # pero la dirección oficial es intellihelp.tech/crm. Todo lo que entre por
    # crm.intellihelp.tech se manda ahí, incluido el callback de Google.
    # Sólo para la instalación de producción: la de pruebas vive en otra
    # carpeta y mandarla a /crm la sacaría de su propia instalación —y de su
    # base— en el medio del ingreso con Google.
    RewriteCond %{HTTP_HOST} ^crm\.intellihelp\.tech$ [NC]
    RewriteCond %{REQUEST_URI} !^/crm-pruebas
    RewriteRule ^(.*)$ https://intellihelp.tech/crm/$1 [R=301,L,QSA]

    # Servir archivos y carpetas reales tal cual (assets, uploads, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo lo demás -> front controller
    # El punto va incluido: el enlace público de la agenda lleva la parte del
    # correo del vendedor (/r/juan.perez/demo-30) y, sin el punto, el servidor
    # devolvía su propio 404 antes de que la aplicación viera nada.
    RewriteRule ^([A-Za-z0-9./_-]*)$ index.php?r=$1 [L,QSA]
</IfModule>

# Proteger archivos sensibles
<FilesMatch "\.(sql|md|json|lock|log|ini|yml|py)$">
    Require all denied
</FilesMatch>

# ---- Rendimiento ----
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Caché larga para assets: CSS y JS van versionados con ?v=, así que es seguro.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2?|ttf|otf|eot|png|jpe?g|gif|svg|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png              "access plus 1 year"
    ExpiresByType image/svg+xml          "access plus 1 year"
    ExpiresByType font/woff2             "access plus 1 year"
</IfModule>
